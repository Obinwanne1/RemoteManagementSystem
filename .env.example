# === Database ===
DATABASE_URL=postgresql://rmm_app:changeme@localhost:5432/rmmdb

# === Flask ===
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-random-256-bit-secret
JWT_SECRET_KEY=change-this-to-another-random-secret
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=604800

# === Redis / Celery ===
# Use 127.0.0.1, NOT localhost — on Windows, localhost resolves IPv6 first (~2.5s penalty per cold connection)
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# === API ===
API_HOST=0.0.0.0
API_PORT=5000
DASHBOARD_URL=http://localhost:3000
# For mobile/LAN access set to your PC's LAN IP, e.g. http://192.168.1.x:8501

# === Agent ===
# One-time org registration token — rotate after all agents registered
ORG_REGISTRATION_TOKEN=change-this-to-a-secure-random-token

# === Superadmin ===
# REQUIRED — API refuses to start without this. Min 10 characters.
SUPERADMIN_EMAIL=superadmin@rmm.local
SUPERADMIN_PASSWORD=change-this-strong-password

# === CORS ===
# Comma-separated list of allowed frontend origins (no wildcards in production)
# Dev: React Vite dev server runs on port 3000
# Prod: set to your public domain only, e.g. https://rmm.yourcompany.com
CORS_ORIGINS=http://localhost:3000

# === Email (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=RMM System <your@email.com>

# === Frontend ===
# React dev server port — used for CORS and Stripe redirect URLs in dev
DASHBOARD_URL=http://localhost:3000
API_BASE_URL=http://127.0.0.1:5000

# === Stripe (Payment Processing) ===
# Get these from https://dashboard.stripe.com/apikeys (use test keys first)
STRIPE_SECRET_KEY=sk_live_...
# Get webhook secret from https://dashboard.stripe.com/webhooks after adding endpoint:
#   POST https://your-api-domain/api/billing/stripe/webhook
#   Events to listen: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...
# Where Stripe redirects after payment (set to your client-facing URL)
STRIPE_SUCCESS_URL=http://localhost:3000/billing?stripe=success
STRIPE_CANCEL_URL=http://localhost:3000/billing?stripe=cancelled

# === Agent Auto-Update ===
# Bump LATEST_AGENT_VERSION when you deploy new agent code.
# Agents running older versions will auto-download and restart.
LATEST_AGENT_VERSION=1.0.0
# Absolute path to the agent zip file served to agents for download.
# Leave blank to disable auto-download (agents will still see update_available=true).
AGENT_UPDATE_PATH=
# Optional changelog shown in dashboard (one line).
AGENT_CHANGELOG=

# === AI Assistant ===
# Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
AI_ASSISTANT_MODEL=claude-haiku-4-5-20251001
AI_ASSISTANT_ENABLED=true

# === Database Backup ===
# Directory where nightly pg_dump backups are saved.
# Use a network drive or cloud-synced path for off-site protection.
BACKUP_DIR=../backups
# Number of days to retain backup files before auto-deletion.
BACKUP_RETAIN_DAYS=7

# === IoT / MQTT ===
# Connect to an external MQTT broker (Mosquitto, HiveMQ, etc.) for sensor ingestion.
# Leave MQTT_HOST blank to disable MQTT polling (no-op, no error).
# Topic convention: {MQTT_TOPIC_PREFIX}/{device_id}/sensors/{sensor_type}
# Payload: JSON {"value": <float>, "unit": "<str>", "channel": "<str|null>"}
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=rmm

# === PSA Integrations ===
# ConnectWise Manage and Autotask credentials are stored encrypted in the DB.
# Configure integrations at Admin → PSA Integrations in the dashboard,
# or via POST /api/psa/integrations.
# Sync runs automatically every 15 minutes via Celery beat.
# ConnectWise: api_url = https://yourserver/v4_6_release/apis/3.0
# Autotask:    api_url = https://webservices1.autotask.net/ATServicesRest/V1.0

# === SNMP ===
# SNMP community string is stored per-device in Device.metadata_.snmp_community
# via the device Edit form. No global config needed here.
# Timeout for each SNMP GET request (seconds).
SNMP_TIMEOUT=3

# === Error Tracking (Sentry) ===
# Get DSN at https://sentry.io — free tier covers 10K errors/month.
# Leave blank to disable (no-op — no errors raised if unset).
SENTRY_DSN=

# === Support Inbox (Email-to-Ticket) ===
# Set these to enable inbound email → auto ticket creation.
# Use an app password (not your main password) for Gmail/Outlook.
SUPPORT_IMAP_HOST=imap.gmail.com
SUPPORT_IMAP_PORT=993
SUPPORT_IMAP_USER=support@yourcompany.com
SUPPORT_IMAP_PASSWORD=your-app-password
# Fallback customer ID for emails from unregistered senders.
# Find the UUID in Admin → Customers. Leave blank to skip unknown senders.
DEFAULT_INBOUND_CUSTOMER_ID=
