# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
env/
.venv/
api/venv/
agent/venv/
dashboard/venv/

# Environment
.env
*.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log
logs/

# Database
*.db
*.sqlite3

# Redis dump
dump.rdb
api/dump.rdb

# Vendored Redis binaries (install Redis/Memurai separately; don't commit it)
redis/
redis.zip

# One-off scratch/patch scripts (not part of the maintained toolchain)
chunk.txt
debug.txt
patch_handover*.py
patch_technical*.py
generate_pdf.py

# Reports / uploads
reports/output/
api/reports/
uploads/
scripts_library/custom/

# Agent screenshots (runtime capture, may show a real device's screen)
api/screenshots/

# Celery beat schedule (runtime artifacts)
api/celerybeat-schedule
api/celerybeat-schedule-shm
api/celerybeat-schedule-wal

# PyInstaller
agent/dist/
agent/build/
agent/*.spec

# Streamlit
.streamlit/secrets.toml

# Agent runtime config — contains a live org token / device_id / encrypted agent_token
agent/config.ini

# Coverage
.coverage
htmlcov/
.pytest_cache/

# Alembic
api/migrations/versions/*.pyc

# TLS certificates (never commit private keys)
nginx/certs/

# MDM credentials (defense-in-depth — design stores these encrypted in the DB
# via upload, never intentionally written to disk, but guard against it anyway)
*.p12
*.pem
google-service-account*.json
